{
  "name": "pi-coding-web",
  "version": "0.73.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:worker": "npm run build --workspace=@mariozechner/pi-web-workspace && tsgo -p tsconfig.worker.json",
    "preview": "vite preview",
    "worker": "npm run build:worker && npm run worker:run",
    "worker:run": "node dist-worker/worker/main.js",
    "rehearse:cutover": "node dist-worker/worker/cutover-rehearsal.js",
    "logs": "node scripts/pi-logs.mjs",
    "test": "tsx ../../node_modules/vitest/dist/cli.js --run --config vitest.config.ts",
    "check": "tsgo --noEmit",
    "clean": "shx rm -rf dist"
  },
  "dependencies": {
    "@mariozechner/mini-lit": "^0.2.0",
    "@mariozechner/pi-agent-core": "file:../../packages/agent",
    "@mariozechner/pi-ai": "file:../../packages/ai",
    "@mariozechner/pi-web-ui": "file:../../packages/web-ui",
    "@mariozechner/pi-web-workspace": "file:../../packages/web-workspace",
    "@tailwindcss/vite": "^4.1.17",
    "cookie-parser": "^1.4.7",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "lit": "^3.3.1",
    "lucide": "^0.544.0",
    "mammoth": "^1.12.0",
    "marked": "^15.0.12",
    "monaco-editor": "^0.55.1",
    "multer": "^2.1.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "typescript": "^5.7.3",
    "vite": "^7.1.6"
  }
}
