{
  "template_id": "multiple_chart_requirement_template_en",
  "template_key": "multiple_chart_requirement",
  "template_name": "Multiple Chart Requirement Template",
  "template_category": "business_requirement",
  "business_domain": "data_visualization",
  "language": "en",
  "version": "1.0.0",
  "status": "enabled",
  "description": "A requirement template for responsive multi-chart dashboards with multiple data sources, chart inventory, layout selection, linked interactions, filters, UI rules, technical specifications, and acceptance criteria.",
  "tags": [
    "multiple-charts",
    "dashboard",
    "visualization",
    "drill-down",
    "data-contract"
  ],
  "applicable_scenarios": [
    "Multi-chart dashboard page",
    "Multiple related QDM data sources",
    "Primary-detail or uniform-grid chart layout",
    "Chart drill-down and cross-filtering",
    "Dashboard export and data accuracy validation"
  ],
  "render_config": {
    "format": "markdown",
    "markdown_relative_path": "data/PRD_template/multiple-chart-requirement-template.en.md"
  },
  "storage_model": "structured_requirement_template.v1",
  "sections": [
    {
      "section_key": "document_info",
      "section_title": "Basic Document Information",
      "sort_order": 1,
      "fields": [
        {
          "field_key": "document_info.document_name",
          "label": "Document name",
          "component": "input",
          "data_type": "string",
          "required": true,
          "placeholder": "D.CHQ.QDM Multiple Chart Requirement"
        },
        {
          "field_key": "document_info.module",
          "label": "System / module",
          "component": "input",
          "data_type": "string",
          "required": true,
          "placeholder": "D.CHQ.QDM / Dashboard and chart presentation"
        }
      ]
    },
    {
      "section_key": "background_objectives",
      "section_title": "Background and Objectives",
      "sort_order": 2,
      "fields": [
        {
          "field_key": "background_objectives.background",
          "label": "Background",
          "component": "textarea",
          "data_type": "string",
          "required": true,
          "placeholder": "Describe the business questions, data sources, and need for a coordinated dashboard"
        },
        {
          "field_key": "background_objectives.objectives",
          "label": "Objectives",
          "component": "list",
          "data_type": "array",
          "required": true,
          "placeholder": "Comparison, drill-down, standardized chart configuration, acceptance targets"
        }
      ]
    },
    {
      "section_key": "scope",
      "section_title": "Scope",
      "sort_order": 3,
      "fields": [
        {
          "field_key": "scope.items",
          "label": "Scope",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "Layout, charts, interactions, data, delivery scope"
        }
      ]
    },
    {
      "section_key": "stakeholders",
      "section_title": "Responsible Parties and Stakeholders",
      "sort_order": 4,
      "fields": [
