# PI Coding Web local runtime configuration.
# Copy this file to .env and edit it for local development.
# .env is ignored by Git. Restart the dev server after changing values.
# Relative paths are resolved from apps/pi-coding-web.

# Storage paths.
# Optional base directory for sessions/settings when PI_SESSIONS_DIR and
# PI_SETTINGS_FILE are not set. Leave empty when using explicit paths below.
PI_STORAGE_DIR=

# Directory for server-side session JSON files.
PI_SESSIONS_DIR=./data/sessions

# File used to persist server-side settings and provider metadata.
PI_SETTINGS_FILE=./data/settings.json

# Root directory for generated project workspaces and preview metadata.
PI_PROJECTS_ROOT_DIR=./data/projects

# Directory for user-installed PI skills.
PI_SKILLS_DIR=./data/skills

# Directory for bundled/default PI skills copied into the local data area.
PI_DEFAULT_SKILLS_DIR=./data/default-skills

# Browser/session behavior.
# Public PI origin used when generating preview URLs. Do not use 0.0.0.0 here.
# Worker-side previews do not have a browser request Host, so local development
# should keep this set to the PI web origin instead of bare http://localhost.
PI_PREVIEW_BASE_URL=http://localhost:5173

# Enables server-backed session persistence. Local browser-only mode keeps this false.
PI_SERVER_SESSION_SYNC_ENABLED=false

# Agent v2 background run runtime. Start a worker process for durable generation.
PI_DB_FILE=./data/pi-runtime.sqlite
PI_REDIS_URL=redis://127.0.0.1:6379
PI_WORKER_ID=pi-local-worker
PI_WORKER_CONCURRENCY=2
PI_AGENT_V2_RUN_QUEUE_NAME=pi:agent-v2:runs
PI_AGENT_V2_RUN_EVENT_STREAM_MAXLEN=5000
PI_AGENT_V2_RUN_EVENT_STREAM_TTL_SECONDS=3600
PI_CLIENT_ID_REQUIRED=true

# Production cutover rehearsal. Configure a real provider/model before running it.
PI_CUTOVER_BASE_URL=http://pi-coding-web:5173
PI_CUTOVER_CLIENT_ID=11111111-1111-4111-8111-111111111111
PI_CUTOVER_MODEL_PROVIDER=
PI_CUTOVER_MODEL_ID=

# Optional default provider/model shown or selected by the PI UI.
PI_DEFAULT_MODEL_PROVIDER=
PI_DEFAULT_MODEL_ID=

# Default thinking level for PM-to-PI handoff when no explicit level is provided.
# Supported values: off, minimal, low, medium, high, xhigh.
PI_HANDOFF_DEFAULT_THINKING_LEVEL=high

# Model request pressure controls.
# Set max output tokens to 0 to rely on each model's configured maxTokens.
# Lower provider payload budgets reduce long-context latency and rate-limit pressure.
PI_MODEL_MAX_OUTPUT_TOKENS=12000
PI_CONTEXT_PROVIDER_PAYLOAD_BUDGET_CHARS=90000

# Generated project builds use the server-controlled ephemeral container runner.
# Raw shell commands from the model are not accepted.

# Diagnostic log storage and retention.
# SQLite database used by the backend-only PI diagnostic log system.
PI_LOG_DB=./data/logs/pi-diagnostics.sqlite

# Master switch for diagnostic logging.
PI_LOG_ENABLED=true

# Emits concise warn/error summaries to server stdout. Full records stay in SQLite.
# Keep this on for local development so missing .env, Redis, and worker issues are visible in terminals.
PI_LOG_STDOUT=true

# Keep at most this many days of logs. 0 disables age-based cleanup.
PI_LOG_RETENTION_DAYS=30

# Keep at most this many log events. 0 disables count-based cleanup.
PI_LOG_MAX_EVENTS=50000

# Minimum interval between cleanup checks after writes.
PI_LOG_CLEANUP_INTERVAL_MS=3600000

# Minimum interval between SQLite VACUUM runs. 0 disables VACUUM.
PI_LOG_VACUUM_INTERVAL_MS=86400000

# Deep model debugging. These can capture prompt, output, tool parameters, or
# provider chunks. Keep them off unless actively investigating a model issue.
PI_LOG_RAW_PROVIDER_ENABLED=false
PI_LOG_RAW_PROVIDER_MAX_CHARS=12000
PI_LOG_PROMPT_SNAPSHOT_ENABLED=false
PI_LOG_PROMPT_SNAPSHOT_MAX_CHARS=20000
PI_LOG_MODEL_OUTPUT_SNAPSHOT_ENABLED=false
PI_LOG_MODEL_OUTPUT_SNAPSHOT_MAX_CHARS=20000

# Langfuse and OpenTelemetry export.
# Enables async export of PI traces/generation observations to Langfuse.
PI_LANGFUSE_ENABLED=false

# Langfuse host. For Langfuse Cloud use https://cloud.langfuse.com.
PI_LANGFUSE_HOST=https://cloud.langfuse.com

# Optional explicit OTLP trace endpoint. Leave unset to use
# <PI_LANGFUSE_HOST>/api/public/otel/v1/traces.
# PI_LANGFUSE_OTEL_ENDPOINT=https://langfuse.example.com/api/public/otel/v1/traces

# Export queue flush interval and max batch size.
PI_LANGFUSE_FLUSH_INTERVAL_MS=5000
PI_LANGFUSE_BATCH_SIZE=50

# Controls whether detailed local snapshots are uploaded to Langfuse.
# These require the matching PI_LOG_* snapshot switches above.
PI_LANGFUSE_EXPORT_PROMPT_SNAPSHOTS=false
PI_LANGFUSE_EXPORT_MODEL_OUTPUT_SNAPSHOTS=false
PI_LANGFUSE_EXPORT_RAW_CHUNKS=false

# OTEL resource attributes shown in Langfuse or collectors.
PI_OTEL_SERVICE_NAME=pi-coding-web
PI_OTEL_DEPLOYMENT_ENVIRONMENT=development

# Secrets.
# Leave empty if PI_LANGFUSE_ENABLED=false. Never commit real keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
