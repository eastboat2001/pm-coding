{
  "template_id": "individual_chart_requirement_template_en",
  "template_key": "individual_chart_requirement",
  "template_name": "Individual Chart Requirement Template",
  "template_category": "business_requirement",
  "business_domain": "data_visualization",
  "language": "en",
  "version": "1.0.0",
  "status": "enabled",
  "description": "A requirement template for one chart or dashboard component, covering business purpose, data contract, chart specification, filters, detail table, interactions, permissions, development requirements, and UAT.",
  "tags": [
    "chart",
    "dashboard",
    "visualization",
    "data-contract",
    "uat"
  ],
  "applicable_scenarios": [
    "Single chart or dashboard component",
    "Metric visualization with filters",
    "Chart data contract confirmation",
    "Chart drill-down and detail table",
    "Chart export and permission rules"
  ],
  "render_config": {
    "format": "markdown",
    "markdown_relative_path": "data/PRD_template/individual-chart-requirement-template.en.md"
  },
  "storage_model": "structured_requirement_template.v1",
  "sections": [
    {
      "section_key": "document_info",
      "section_title": "Basic Document Information",
      "sort_order": 1,
      "fields": [
        {
          "field_key": "document_info.chart_name",
          "label": "Chart / page name",
          "component": "input",
          "data_type": "string",
          "required": true,
          "placeholder": "Enter chart or page name"
        },
        {
          "field_key": "document_info.business_owner",
          "label": "Business owner",
          "component": "input",
          "data_type": "string",
          "required": true,
          "placeholder": "Name or team responsible for approval"
        }
      ]
    },
    {
      "section_key": "background_objectives",
      "section_title": "Background and Objectives",
      "sort_order": 2,
      "fields": [
        {
          "field_key": "background_objectives.background",
          "label": "Background",
          "component": "textarea",
          "data_type": "string",
          "required": true,
          "placeholder": "Describe the business context, pain point, and decision scenario"
        },
        {
          "field_key": "background_objectives.objectives",
          "label": "Objectives",
          "component": "list",
          "data_type": "array",
          "required": true,
          "placeholder": "Describe the chart objective and success criteria"
        }
      ]
    },
    {
      "section_key": "scope",
      "section_title": "Scope",
      "sort_order": 3,
      "fields": [
        {
          "field_key": "scope.items",
          "label": "Scope",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "In scope, out of scope, assumptions, dependencies, constraints"
        }
      ]
    },
    {
      "section_key": "stakeholders",
      "section_title": "Responsible Parties and Stakeholders",
      "sort_order": 4,
      "fields": [
        {
          "field_key": "stakeholders.roles",
          "label": "Stakeholder roles",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "Business owner, data owner, BA, UI/UX, developers, QA, approver"
        }
      ]
    },
    {
      "section_key": "data_description",
      "section_title": "Data Description",
      "sort_order": 5,
      "fields": [
        {
          "field_key": "data_description.sources",
          "label": "Data source",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "Source/table/API, owner, refresh frequency, data grain"
        },
        {
          "field_key": "data_description.fields",
          "label": "Key fields and business definitions",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "Field name, business definition, type, required, source logic"
        },
        {
          "field_key": "data_description.logic_rules",
          "label": "Calculation and logic rules",
          "component": "list",
          "data_type": "array",
          "required": true,
          "placeholder": "Metric formula, filtering, date logic, null handling, deduplication"
        }
      ]
    },
    {
      "section_key": "chart_presentation",
      "section_title": "Page and Chart Presentation",
      "sort_order": 6,
      "fields": [
        {
          "field_key": "chart_presentation.layout",
          "label": "Page layout",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "Query area, chart display area, detail area"
        },
        {
          "field_key": "chart_presentation.chart_spec",
          "label": "Chart specification",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "Chart type, metric, axes, legend, tooltip, drill-down, states"
        }
      ]
    },
    {
      "section_key": "filters_detail",
      "section_title": "Query Conditions and Detail Table",
      "sort_order": 7,
      "fields": [
        {
          "field_key": "filters_detail.filters",
          "label": "Query conditions and filters",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "Filter field, control type, default, required, dependency"
        },
        {
          "field_key": "filters_detail.detail_columns",
          "label": "Detail table fields",
          "component": "table",
          "data_type": "array",
          "required": false,
          "placeholder": "Column, source field, format, sortable, notes"
        }
      ]
    },
    {
      "section_key": "interactions_permissions",
      "section_title": "Interaction, Permission, and Export Requirements",
      "sort_order": 8,
      "fields": [
        {
          "field_key": "interactions_permissions.requirements",
          "label": "Interaction and permission requirements",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "Responsive layout, hover/click, export, permissions, audit, accessibility"
        }
      ]
    },
    {
      "section_key": "development",
      "section_title": "Development Requirements",
      "sort_order": 9,
      "fields": [
        {
          "field_key": "development.technical_specs",
          "label": "Technical specifications",
          "component": "list",
          "data_type": "array",
          "required": false,
          "placeholder": "HTML, Bootstrap, JavaScript, jQuery, API contract, response schema"
        },
        {
          "field_key": "development.performance_security",
          "label": "Performance and security",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "Performance, security, compatibility, error handling"
        }
      ]
    },
    {
      "section_key": "color_system",
      "section_title": "Color System",
      "sort_order": 10,
      "fields": [
        {
          "field_key": "color_system.tokens",
          "label": "Color tokens",
          "component": "table",
          "data_type": "array",
          "required": false,
          "placeholder": "Approved color token and value"
        }
      ]
    },
    {
      "section_key": "acceptance",
      "section_title": "Acceptance Criteria and UAT Checklist",
      "sort_order": 11,
      "fields": [
        {
          "field_key": "acceptance.criteria",
          "label": "Acceptance criteria",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "Chart values, filters, states, detail table, export, responsiveness, permissions"
        }
      ]
    },
    {
      "section_key": "open_questions",
      "section_title": "Open Questions and Change Log",
      "sort_order": 12,
      "fields": [
        {
          "field_key": "open_questions.questions",
          "label": "Open questions",
          "component": "table",
          "data_type": "array",
          "required": false,
          "placeholder": "Question, owner, due date, resolution"
        }
      ]
    }
  ]
}
