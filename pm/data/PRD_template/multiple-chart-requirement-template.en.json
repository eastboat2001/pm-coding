        {
          "field_key": "filters_interactions.rules",
          "label": "Interaction rules",
          "component": "list",
          "data_type": "array",
          "required": true,
          "placeholder": "Cross-filtering, active state, tooltip, keyboard legend, export context"
        }
      ]
    },
    {
      "section_key": "ui_design",
      "section_title": "UI and Visual Design Requirements",
      "sort_order": 10,
      "fields": [
        {
          "field_key": "ui_design.requirements",
