          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "Field name, source, type, required, business logic"
        },
        {
          "field_key": "data_contract.rules",
          "label": "Field logic and data rules",
          "component": "list",
          "data_type": "array",
          "required": true,
          "placeholder": "Join keys, aggregation level, formulas, null handling, labels"
        }
      ]
