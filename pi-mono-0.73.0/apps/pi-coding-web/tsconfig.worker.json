{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist-worker",
		"module": "Node16",
		"moduleResolution": "Node16",
		"paths": {
			"*": ["./*"],
			"@mariozechner/pi-agent-core": ["../../packages/agent/dist/index.d.ts"],
			"@mariozechner/pi-ai": ["../../packages/ai/dist/index.d.ts"],
			"@mariozechner/pi-web-workspace": ["../../packages/web-workspace/dist/index.d.ts"],
			"@mariozechner/pi-web-workspace/skill-tool-contract": [
				"../../packages/web-workspace/dist/skill-tool-contract.d.ts"
			]
		},
		"declaration": false,
		"declarationMap": false,
		"sourceMap": true
	},
	"include": [
		"src/worker/**/*.ts",
		"src/prompts/**/*.ts",
		"src/project-tools/history.ts",
		"src/project-tools/omitted-content.ts",
		"src/skill-tools/skill-command.ts",
		"src/skill-tools/schemas.ts"
	]
}
