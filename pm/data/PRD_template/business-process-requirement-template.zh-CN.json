{
  "template_id": "business_process_requirement_template_zh_cn",
  "template_key": "business_process_requirement",
  "template_name": "业务流程需求模板",
  "template_category": "business_requirement",
  "business_domain": "business_process",
  "language": "zh-CN",
  "version": "1.0.0",
  "status": "enabled",
  "description": "适用于流程发起、评审审批、待办处理、权限控制、审计历史、系统集成和 UAT 验收的业务流程需求模板。",
  "tags": [
    "business-process",
    "workflow",
    "approval",
    "permissions",
    "audit",
    "uat"
  ],
  "applicable_scenarios": [
    "工作流或审批流程需求",
    "待办列表和流程历史页面",
    "基于角色的权限与审计控制",
    "数据驱动的流程校验",
    "业务流程 UAT 和签署",
    "配置驱动的流程管理"
  ],
  "render_config": {
    "format": "markdown",
    "markdown_relative_path": "data/PRD_template/business-process-requirement-template.zh-CN.md"
  },
  "storage_model": "structured_requirement_template.v1",
  "sections": [
    {
      "section_key": "document_info",
      "section_title": "基础文档信息",
      "sort_order": 1,
      "fields": [
        {
          "field_key": "document_info.document_name",
          "label": "文档名称",
          "component": "input",
          "data_type": "string",
          "required": true,
          "placeholder": "例如：D.CHQ.QDM 业务流程需求"
        },
        {
          "field_key": "document_info.process_name",
          "label": "业务流程名称",
          "component": "input",
          "data_type": "string",
          "required": true,
          "placeholder": "请输入业务流程名称"
        },
        {
          "field_key": "document_info.owner",
          "label": "业务负责人",
          "component": "input",
          "data_type": "string",
          "required": true,
          "placeholder": "请输入业务负责人"
        },
        {
          "field_key": "document_info.status",
          "label": "文档状态",
          "component": "select",
          "data_type": "string",
          "required": false,
          "options": [
            "草稿",
            "评审中",
            "已批准"
          ]
        }
      ]
    },
    {
      "section_key": "background_objectives",
      "section_title": "背景与目标",
      "sort_order": 2,
      "fields": [
        {
          "field_key": "background_objectives.background",
          "label": "背景说明",
          "component": "textarea",
          "data_type": "string",
          "required": true,
          "placeholder": "描述当前流程背景、痛点和系统化支持原因"
        },
        {
          "field_key": "background_objectives.objectives",
          "label": "目标",
          "component": "list",
          "data_type": "array",
          "required": true,
          "placeholder": "定义期望达成的业务结果"
        }
      ]
    },
    {
      "section_key": "scope",
      "section_title": "范围",
      "sort_order": 3,
      "fields": [
        {
          "field_key": "scope.in_scope",
          "label": "本次范围",
          "component": "list",
          "data_type": "array",
          "required": true,
          "placeholder": "列出流程、数据、页面、报表和配置范围"
        },
        {
          "field_key": "scope.out_of_scope",
          "label": "非本次范围",
          "component": "list",
          "data_type": "array",
          "required": false,
          "placeholder": "列出本次明确不包含的内容"
        }
      ]
    },
    {
      "section_key": "stakeholders",
      "section_title": "责任方与干系人",
      "sort_order": 4,
      "fields": [
        {
          "field_key": "stakeholders.roles",
          "label": "干系人角色",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "业务发起人、业务负责人、操作人、IT、数据、QA、安全"
        }
      ]
    },
    {
      "section_key": "data_description",
      "section_title": "数据说明",
      "sort_order": 5,
      "fields": [
        {
          "field_key": "data_description.sources",
          "label": "数据来源",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "来源名称、类型、负责人、刷新频率、用途、备注"
        },
        {
          "field_key": "data_description.fields",
          "label": "关键字段与数据字典",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "字段名、业务定义、类型、是否必填、校验、示例"
        },
        {
          "field_key": "data_description.quality_rules",
          "label": "数据逻辑与质量规则",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "必填校验、状态流转校验、错误提示"
        }
      ]
    },
    {
      "section_key": "process_description",
      "section_title": "流程说明",
      "sort_order": 6,
      "fields": [
        {
          "field_key": "process_description.flowchart",
          "label": "流程图",
          "component": "textarea",
          "data_type": "string",
          "required": true,
          "placeholder": "描述或插入已确认的流程图"
        },
        {
          "field_key": "process_description.step_matrix",
          "label": "流程步骤矩阵",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "步骤、角色、输入、活动、输出、下一状态"
        }
      ]
    },
    {
      "section_key": "business_rules",
      "section_title": "业务规则",
      "sort_order": 7,
      "fields": [
        {
          "field_key": "business_rules.rules",
          "label": "业务规则",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "规则 ID、规则、负责人、优先级、备注"
        }
      ]
    },
    {
      "section_key": "pages_functions",
      "section_title": "页面 / 功能呈现",
      "sort_order": 8,
      "fields": [
        {
          "field_key": "pages_functions.page_list",
          "label": "页面与功能清单",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "流程发起页、待办列表、详情历史、配置、权限管理"
        },
        {
          "field_key": "pages_functions.ui_behavior",
          "label": "UI 行为与布局要求",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "响应式、表单校验、查询筛选、审计可见性、空态错误态"
        }
      ]
    },
    {
      "section_key": "permissions_controls",
      "section_title": "权限与控制",
      "sort_order": 9,
      "fields": [
        {
          "field_key": "permissions_controls.matrix",
          "label": "权限矩阵",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "发起人、评审人、审批人、管理员、安全角色的权限"
        }
      ]
    },
    {
      "section_key": "audit_compliance",
      "section_title": "审计与合规要求",
      "sort_order": 10,
      "fields": [
        {
          "field_key": "audit_compliance.requirements",
          "label": "审计与合规要求",
          "component": "list",
          "data_type": "array",
          "required": true,
          "placeholder": "审计轨迹、敏感数据访问、保留周期、导出控制"
        }
      ]
    },
    {
      "section_key": "development_requirements",
      "section_title": "开发要求",
      "sort_order": 11,
      "fields": [
        {
          "field_key": "development_requirements.technical_specs",
          "label": "技术规格",
          "component": "textarea",
          "data_type": "string",
          "required": false,
          "placeholder": "HTML、Bootstrap、JavaScript、jQuery，或已确认项目技术栈"
        },
        {
          "field_key": "development_requirements.color_system",
          "label": "色彩系统",
          "component": "table",
          "data_type": "array",
          "required": false,
          "placeholder": "色彩 token、取值和用途"
        }
      ]
    },
    {
      "section_key": "integrations",
      "section_title": "集成与接口要求",
      "sort_order": 12,
      "fields": [
        {
          "field_key": "integrations.interfaces",
          "label": "接口",
          "component": "table",
          "data_type": "array",
          "required": false,
          "placeholder": "接口、方向、载荷、频率、失败处理、负责人"
        }
      ]
    },
    {
      "section_key": "non_functional",
      "section_title": "非功能需求",
      "sort_order": 13,
      "fields": [
        {
          "field_key": "non_functional.requirements",
          "label": "非功能需求",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "性能、可用性、安全、易用性、可维护性"
        }
      ]
    },
    {
      "section_key": "acceptance_testing",
      "section_title": "验收标准与测试",
      "sort_order": 14,
      "fields": [
        {
          "field_key": "acceptance_testing.criteria",
          "label": "验收标准",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "AC ID、验收标准、测试方法、负责人、状态"
        },
        {
          "field_key": "acceptance_testing.uat_signoff",
          "label": "UAT 签署",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "业务、IT、安全签署结论"
        }
      ]
    },
    {
      "section_key": "risks_open_questions",
      "section_title": "风险、依赖与待确认问题",
      "sort_order": 15,
      "fields": [
        {
          "field_key": "risks_open_questions.risks",
          "label": "风险与依赖",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "风险/依赖 ID、影响、缓解措施、负责人"
        },
        {
          "field_key": "risks_open_questions.questions",
          "label": "待确认问题",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "问题、负责人、目标日期、结论"
        }
      ]
    },
    {
      "section_key": "completion_checklist",
      "section_title": "建议完成检查清单",
      "sort_order": 16,
      "fields": [
        {
          "field_key": "completion_checklist.items",
          "label": "完成检查清单",
          "component": "table",
          "data_type": "array",
          "required": false,
          "placeholder": "文档、范围、数据、流程、页面、开发、测试"
        }
      ]
    }
  ]
}
