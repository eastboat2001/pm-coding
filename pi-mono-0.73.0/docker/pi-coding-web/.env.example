# PI Coding Web Docker deployment configuration.
# Copy this file to .env before running docker compose.
# .env is ignored by Git. Restart containers after changing values.

# Image tags loaded from the offline tar package.
PI_CODING_WEB_IMAGE=pi-coding-web:0.73.0
PI_POSTGRES_IMAGE=postgres:16-alpine
PI_REDIS_IMAGE=redis:7-alpine

# Use never for offline deployment so Docker does not pull from a registry.
PI_CODING_WEB_PULL_POLICY=never
PI_POSTGRES_PULL_POLICY=never
PI_REDIS_PULL_POLICY=never

# Public web port. Keep host bind as 0.0.0.0 when LAN users need access.
PI_CODING_WEB_HOST_BIND=0.0.0.0
PI_CODING_WEB_PORT=5173

# PostgreSQL and Redis are not published to the host by default. Web and worker
# use the internal Compose network, so LAN/host port exposure is unnecessary.

# PostgreSQL runtime database. If you change user/password/db here, update
# PI_POSTGRES_URL to match.
PI_POSTGRES_DB=pi_coding
PI_POSTGRES_USER=pi
PI_POSTGRES_PASSWORD=pi
PI_RUNTIME_STORE=postgres
PI_POSTGRES_URL=postgres://pi:pi@postgres:5432/pi_coding

# Redis is used by the run queue and live run event streams.
PI_REDIS_URL=redis://redis:6379

# Storage paths. Relative paths are resolved from /app/apps/pi-coding-web in
# the container. The Compose file bind-mounts ./data/app to that app data dir.
# PostgreSQL and Redis use Podman named volumes because their official images
# chown data directories on startup, which is often blocked on rootless bind
# mounts in intranet server filesystems.
PI_STORAGE_DIR=
PI_CLIENTS_ROOT_DIR=./data/clients
PI_SETTINGS_FILE=./data/settings.json
PI_SKILLS_DIR=./data/skills
PI_DEFAULT_SKILLS_DIR=./data/default-skills

# SQLite fallback path. Leave commented for PostgreSQL deployments.
# PI_DB_FILE=./data/runtime/pi-runtime.sqlite

# Public PI origin used when generating preview URLs. Do not use 0.0.0.0 here.
# Set this to the browser-accessible origin on the intranet server.
PI_PREVIEW_BASE_URL=http://localhost:5173

# Docker deployment should keep this true so sessions survive browser reloads.
PI_SERVER_SESSION_SYNC_ENABLED=true

# Background run runtime.
PI_RUNS_ENABLED=true
PI_WORKER_ID=pi-worker
PI_WORKER_CONCURRENCY=2
PI_RUN_QUEUE_NAME=pi:runs
PI_RUN_EVENT_RETENTION_DAYS=30
PI_RUN_EVENT_STREAM_MAXLEN=5000
PI_RUN_EVENT_STREAM_TTL_SECONDS=3600
PI_RUN_EVENT_CHECKPOINT_INTERVAL_MS=400
PI_RUN_EVENT_CHECKPOINT_MIN_CHARS=256
PI_CLIENT_ID_REQUIRED=true

# Optional default provider/model shown or selected by the PI UI.
PI_DEFAULT_MODEL_PROVIDER=
PI_DEFAULT_MODEL_ID=

# Default thinking level for PM-to-PI handoff when no explicit level is provided.
# Supported values: off, minimal, low, medium, high, xhigh.
PI_HANDOFF_DEFAULT_THINKING_LEVEL=high

# Generated project build commands.
# Used only by project_task build_static; raw shell commands from the model are
# not accepted.
PI_PROJECT_INSTALL_COMMAND=npm install
PI_PROJECT_BUILD_COMMAND=npm run build
PI_PROJECT_INSTALL_TIMEOUT_MS=300000
PI_PROJECT_BUILD_TIMEOUT_MS=300000

# Diagnostic log storage and retention. Runtime data is PostgreSQL; diagnostic
# logs remain in a small local SQLite file under the mounted data volume.
PI_LOG_DB=./data/logs/pi-diagnostics.sqlite
PI_LOG_ENABLED=true
PI_LOG_STDOUT=true
PI_LOG_RETENTION_DAYS=30
PI_LOG_MAX_EVENTS=50000
PI_LOG_CLEANUP_INTERVAL_MS=3600000
PI_LOG_VACUUM_INTERVAL_MS=86400000

# Deep model debugging. These can capture prompt, output, tool parameters, or
# provider chunks. Keep them off unless actively investigating a model issue.
PI_LOG_RAW_PROVIDER_ENABLED=false
PI_LOG_RAW_PROVIDER_MAX_CHARS=12000
PI_LOG_PROMPT_SNAPSHOT_ENABLED=false
PI_LOG_PROMPT_SNAPSHOT_MAX_CHARS=20000
PI_LOG_MODEL_OUTPUT_SNAPSHOT_ENABLED=false
PI_LOG_MODEL_OUTPUT_SNAPSHOT_MAX_CHARS=20000

# Fails a stalled provider/model stream after this idle period so runs do not
# remain running forever when the provider connection hangs.
PI_MODEL_STREAM_IDLE_TIMEOUT_MS=60000

# Langfuse and OpenTelemetry export.
PI_LANGFUSE_ENABLED=false
PI_LANGFUSE_HOST=https://cloud.langfuse.com
PI_LANGFUSE_OTEL_ENDPOINT=
PI_LANGFUSE_FLUSH_INTERVAL_MS=5000
PI_LANGFUSE_BATCH_SIZE=50
PI_LANGFUSE_EXPORT_PROMPT_SNAPSHOTS=false
PI_LANGFUSE_EXPORT_MODEL_OUTPUT_SNAPSHOTS=false
PI_LANGFUSE_EXPORT_RAW_CHUNKS=false
PI_OTEL_SERVICE_NAME=pi-coding-web
PI_OTEL_DEPLOYMENT_ENVIRONMENT=production

# Secrets. Leave empty if PI_LANGFUSE_ENABLED=false. Never commit real keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
