# Copy this file to pi-storage.secrets.env on the server.
# pi-storage.secrets.env is ignored by Git.

# Langfuse keys. Leave empty if langfuseEnabled is false.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional runtime overrides. These override pi-storage.config.json when set.
# PI_LANGFUSE_HOST=https://cloud.langfuse.com
# PI_LANGFUSE_OTEL_ENDPOINT=
# PI_OTEL_DEPLOYMENT_ENVIRONMENT=production
