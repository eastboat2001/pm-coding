{
  "name": "@mariozechner/pi-web-workspace",
  "version": "0.73.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./agent-v2-runtime": {
      "types": "./dist/agent-v2-runtime.d.ts",
      "import": "./dist/agent-v2-runtime.js",
      "default": "./dist/agent-v2-runtime.js"
    },
    "./agent-v2-response-language": {
      "types": "./dist/agent-v2-response-language.d.ts",
      "import": "./dist/agent-v2-response-language.js",
      "default": "./dist/agent-v2-response-language.js"
    },
    "./runtime-infra": {
      "types": "./dist/runtime-infra.d.ts",
      "import": "./dist/runtime-infra.js",
      "default": "./dist/runtime-infra.js"
    },
    "./skill-tool-contract": {
      "types": "./dist/skill-tool-contract.d.ts",
      "import": "./dist/skill-tool-contract.js",
      "default": "./dist/skill-tool-contract.js"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsgo -p tsconfig.build.json",
    "build:emit": "tsc -p tsconfig.build.json",
    "test": "npm run build && node test/workspace.test.mjs && tsx ../../node_modules/vitest/dist/cli.js --run --exclude test/workspace.test.mjs",
    "check": "tsgo --noEmit",
    "sync:source-mirrors": "node scripts/source-mirrors.mjs sync",
    "check:source-mirrors": "node scripts/source-mirrors.mjs audit"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "redis": "^4.7.0",
    "typebox": "^1.1.24",
    "vite": "^7.1.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "shx": "^0.4.0",
    "typescript": "^5.7.3"
  }
}
